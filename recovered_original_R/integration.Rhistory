library(readr)
library(dplyr)
deseq <- read_csv("DESeq2_Significant_Genera.csv")
network <- read_csv("Top_Microbe_Pathway_Network.csv")
taxonomy <- read_csv("taxonomy.csv")
colnames(deseq)
colnames(deseq)[1] <- "Genus"
colnames(deseq)
head(deseq)
head(taxonomy)
taxonomy_unique <- taxonomy %>%
  distinct(Genus, .keep_all = TRUE)
nrow(taxonomy)
nrow(taxonomy_unique)
taxa_merge <- left_join(deseq, taxonomy_unique, by = "Genus")
head(taxa_merge)
sum(is.na(taxa_merge$Phylum))
colnames(network)
head(network)
final_integration <- left_join(
  taxa_merge,
  network,
  by = "Genus"
)
head(final_integration)
dim(final_integration)
library(dplyr)
final_integration <- final_integration %>%
  mutate(Pathway = recode(
    Pathway,
    "LPSSYN-PWY" = "Lipopolysaccharide biosynthesis",
    "PEPTIDOGLYCANSYN-PWY" = "Peptidoglycan biosynthesis"
  ))
unique(final_integration$Pathway)
final_table <- final_integration %>%
  select(
    Genus,
    Phylum,
    Family,
    log2FoldChange,
    padj,
    Pathway,
    Rho,
    FDR
  )
head(final_table)
write.csv(
  final_table,
  "Final_Integrated_Taxonomy_Function.csv",
  row.names = FALSE
)
write.csv(final_table, "Final_Integrated_Taxonomy_Function.csv", row.names = FALSE)
list.files()
table(final_table$Pathway)
final_table %>%
  arrange(padj) %>%
  select(Genus, Phylum, Family, log2FoldChange, padj, Pathway, Rho) %>%
  head(20)
key_microbes <- final_table %>%
  filter(!is.na(Pathway)) %>%
  arrange(padj)
View(key_microbes)
key_microbes_unique <- key_microbes %>%
  distinct(Genus, .keep_all = TRUE)
View(key_microbes_unique)
write.csv(
  key_microbes_unique,
  "Key_Microbes_Immune_Pathways.csv",
  row.names = FALSE
)
key_microbes <- final_table %>%
  filter(!is.na(Pathway))
key_microbes_unique <- key_microbes %>%
  distinct(Genus, .keep_all = TRUE)
key_microbes_unique <- key_microbes_unique %>%
  arrange(padj)
write.csv(
  key_microbes_unique,
  "Key_Microbes_Immune_Pathways.csv",
  row.names = FALSE
)
head(key_microbes_unique, 15)
dim(key_microbes_unique)
