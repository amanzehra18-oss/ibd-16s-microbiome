colnames(pcoa)
ggplot(pcoa, aes(x = PC1, y = PC2, color = Group)) +
  geom_point(size = 4) +
  stat_ellipse(level = 0.95) +
  theme_classic() +
  labs(
    title = "PCoA Plot (Bray-Curtis)",
    x = "PC1",
    y = "PC2"
  )
